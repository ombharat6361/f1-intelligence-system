# LLM
GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=llama-3.3-70b-versatile

# Set to true to skip R2 upload entirely (report still renders in the UI)
DISABLE_R2=false

# Cloudflare R2 (free tier, S3-compatible)
# Account ID is in the R2 dashboard sidebar
R2_ACCOUNT_ID=your_cloudflare_account_id
# Create an R2 API token with Object Read & Write permissions
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=f1-intelligence-reports
# Optional: custom domain or R2 public URL base (e.g. https://reports.yourdomain.com)
# If unset, the internal endpoint URL is returned instead
R2_PUBLIC_URL=

# ChromaDB (local path or remote)
CHROMA_PERSIST_DIR=./knowledge_base/chroma_db

# App settings
LOG_LEVEL=INFO
OPENF1_BASE_URL=https://api.openf1.org/v1
