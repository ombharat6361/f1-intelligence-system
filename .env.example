# LLM
GROQ_API_KEY=your_groq_api_key_here

# Set to true to skip R2 upload entirely (report still renders in the UI)
DISABLE_R2=false

# Cloudflare R2 (free tier, S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=f1-intelligence-reports
R2_PUBLIC_URL=

# ChromaDB (local path or remote)
CHROMA_PERSIST_DIR=./knowledge_base/chroma_db

# FastF1 cache directory (downloaded timing data)
FASTF1_CACHE_DIR=./cache/fastf1

# App settings
LOG_LEVEL=INFO
